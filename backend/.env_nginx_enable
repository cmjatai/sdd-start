server {
    if ($host = www.leandrojatai.dev.br) {
        return 301 https://$host$request_uri;
    }

    if ($host = leandrojatai.dev.br) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name leandrojatai.dev.br www.leandrojatai.dev.br;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location = /.well-known/acme-challenge/letsdebug-test {
        default_type text/plain;
        add_header X-msg-debug "new listen 80 '$host'";
        return 200 'letsdebug-test';
    }

    location / {
        return 301 https://www.leandrojatai.dev.br$request_uri;
    }
}

server {
    if ($host = backend.leandrojatai.dev.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name backend.leandrojatai.dev.br;

    access_log /var/log/nginx/access__www2.log;
    error_log /var/log/nginx/error__www2.log;

    location = /.well-known/acme-challenge/letsdebug-test {
        default_type text/plain;
        add_header X-msg-debug "listen 80 '$host'";
        return 200 'letsdebug-test';
    }

    location / {
        return 301 https://backend.leandrojatai.dev.br$request_uri;
    }
}

server {

    server_name leandrojatai.dev.br;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location = /.well-known/acme-challenge/letsdebug-test {
        default_type text/plain;
        add_header X-msg-debug "listen 443 redirect.";
        return 200 'letsdebug-test';
    }

    location / {
        return 301 https://www.leandrojatai.dev.br$request_uri;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/leandrojatai.dev.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/leandrojatai.dev.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {

    server_name backend.leandrojatai.dev.br;

    client_max_body_size 4G;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/access__backend.log;
    error_log /var/log/nginx/error__backend.log;

    location /ws/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_redirect off;

        proxy_pass http://localhost:9001;
    }

    #location /.well-known/traffic-advice {
    #    types { } default_type "application/trafficadvice+json; charset=utf-8";
    #    alias /root/projects/sdd-start/backend/.well-known/traffic-advice;
    #    allow all;
    #}

    location = /.well-known/acme-challenge/letsdebug-test {
        default_type text/plain;
        #add_header X-msg-debug "listen 443 in server www final: $subdomain.";
        return 200 'letsdebug-test';
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 600s;
        proxy_connect_timeout 75s;

        proxy_pass http://localhost:9001;
        proxy_redirect http://localhost:9001 https://$host;
    }

    listen 443 ssl; # managed by Certbot

        ssl_certificate /etc/letsencrypt/live/leandrojatai.dev.br/fullchain.pem; # managed by Certbot
        ssl_certificate_key /etc/letsencrypt/live/leandrojatai.dev.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
